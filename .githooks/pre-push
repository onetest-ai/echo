#!/usr/bin/env bash
# Before a push: the functional map must be consistent, and a branch that changed app code must have updated it.
# Installed by `git config core.hooksPath .githooks` (tests/install.sh does it). To push anyway, for a change with
# no behaviour of its own, use `git push --no-verify` and say why in the PR ("Map: no behaviour change — <why>").
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
# Pushing main itself (a merge) is checked on its branch already.
while read -r local_ref _ remote_ref _; do
  [ "$remote_ref" = "refs/heads/main" ] && exit 0
done
if ! out="$(python3 tests/tools/feature-map.py check)"; then
  echo "$out" >&2
  echo "pre-push: the functional map has problems (tests/tools/feature-map.py check)" >&2
  exit 1
fi
python3 tests/tools/feature-map.py changes main || { echo "pre-push: update tests/feature-map/ for this change, or push with --no-verify if it changes no behaviour (and say why in the PR)" >&2; exit 1; }
