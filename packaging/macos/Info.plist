<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>ai.onetest.echo.link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>echo</string>
      </array>
    </dict>
  </array>
  <key>CFBundleIdentifier</key>
  <string>ai.onetest.echo</string>
  <key>CFBundleName</key>
  <string>Echo</string>
  <key>CFBundleDisplayName</key>
  <string>Echo</string>
  <key>CFBundleExecutable</key>
  <string>echoctl</string>
  <key>CFBundleIconFile</key>
  <string>echo</string>
  <!-- macOS 26: the Icon Composer icon in Assets.car; older macOS uses echo.icns. -->
  <key>CFBundleIconName</key>
  <string>echo</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__BUILD__</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.2</string>
  <!-- Menu-bar app: no Dock icon, no app menu. -->
  <key>LSUIElement</key>
  <true/>
  <key>LSMultipleInstancesProhibited</key>
  <true/>
  <!-- Launched with no arguments from the bundle, the binary runs the app (main.rs);
       with arguments it is the CLI. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Echo records your side of the calls you choose to record, to transcribe them on this Mac.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Echo records what the other participants say in the calls you choose to record (from the Teams app only), to transcribe them on this Mac.</string>
  <key>NSHumanReadableCopyright</key>
  <string>onetest.ai</string>
</dict>
</plist>
