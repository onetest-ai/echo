// Echo's icon in echoctl.exe (Explorer, pinned taskbar buttons, Alt-Tab), embedded by
// crates/echoctl/build.rs. echo.ico comes from `echoctl dev-icon packaging/windows/echo.ico`.
1 ICON "echo.ico"

// Echo's name in echoctl.exe: the taskbar button's menu, Task Manager and Explorer show FileDescription (#420).
// ECHO_V1..3: the package version, from build.rs.
1 VERSIONINFO
FILEVERSION ECHO_V1, ECHO_V2, ECHO_V3, 0
PRODUCTVERSION ECHO_V1, ECHO_V2, ECHO_V3, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Echo"
      VALUE "ProductName", "Echo"
      VALUE "InternalName", "echoctl"
      VALUE "OriginalFilename", "echoctl.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
