<?xml version="1.0" encoding="utf-8"?>
<!--
  Echo's Windows installer (WiX 5: `scripts/package-windows.ps1` builds it from the staged zip
  contents). Per user, no administrator rights: %LOCALAPPDATA%\Programs\echo, a Start menu
  shortcut, the folder on the user PATH, Echo started at login (the same Run value as
  `echoctl app autostart on`). A running Echo is quit before files are replaced and started
  again at the end. Uninstalling keeps the data folder, models and settings.
  Defines: Version (numeric x.y.z), Stage (folder with echoctl.exe and the rest).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Echo" Manufacturer="onetest" Version="$(Version)" Scope="perUser"
           UpgradeCode="D44EBF08-4992-4EB5-AFC0-462D9A78759A" Compressed="yes">
    <!-- Same-version upgrades too: a rebuilt beta replaces the installed one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Echo is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="echo.ico" SourceFile="$(sys.SOURCEFILEDIR)echo.ico" />
    <Property Id="ARPPRODUCTICON" Value="echo.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/onetest-ai/echo" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="echo" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(Stage)\**" />
    </ComponentGroup>

    <!-- Per-user components keep a HKCU value as their key path. -->
    <Component Id="Integration" Directory="INSTALLFOLDER" Guid="5F0B5E3A-1E7C-4C59-9C2B-6A0E7F3D2B11">
      <RegistryValue Root="HKCU" Key="Software\onetest\Echo" Name="InstallFolder" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Echo"
                     Type="string" Value="&quot;[INSTALLFOLDER]echoctl.exe&quot; app run --background" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set"
                   System="no" Permanent="no" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="8C7A2D41-3B6E-4F0A-A5D9-2E4C1B7F9A63">
        <!-- AppUserModelID = the one Echo's toasts use, so they belong to this shortcut. -->
        <Shortcut Id="EchoShortcut" Name="Echo" Description="Records and transcribes Teams calls"
                  Target="[INSTALLFOLDER]echoctl.exe" WorkingDirectory="INSTALLFOLDER" Icon="echo.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="onetest.Echo" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\onetest\Echo" Name="StartMenu" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Integration" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Quit a running Echo (an older install here, or a zip copy unzipped to this folder) so
         its files can be replaced or removed; `app quit` waits until it has exited. A missing
         echoctl.exe (first install) just fails, ignored. -->
    <CustomAction Id="QuitEcho" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]echoctl.exe&quot; app quit"
                  Execute="immediate" Return="ignore" />
    <!-- Start it again (or for the first time) unless this was an uninstall. -->
    <CustomAction Id="StartEcho" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]echoctl.exe&quot; app start"
                  Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="QuitEcho" Before="InstallValidate" />
      <Custom Action="StartEcho" After="InstallFinalize" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
