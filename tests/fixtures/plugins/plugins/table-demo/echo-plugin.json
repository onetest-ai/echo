{
  "id": "table-demo",
  "name": "Table demo",
  "version": "0.2.0",
  "summary": "A test plugin: a table widget (groups, pills, dates, numbers, a row's details, links) and stats with links and a count set to a thread or a client (tests/cases/today/TC-042, TC-044).",
  "main": "main.js",
  "widgets": [
    {
      "id": "staffing",
      "label": "Needs attention",
      "about": "Positions to staff, by project",
      "kind": "table",
      "sizes": [
        "M",
        "L"
      ],
      "heights": [
        1,
        2
      ]
    },
    {
      "id": "counts",
      "label": "Staffing",
      "about": "Counts that open their rows",
      "kind": "stats",
      "sizes": [
        "M",
        "L"
      ]
    },
    {
      "id": "wrong",
      "label": "Wrong table",
      "about": "A table whose data Echo can't draw",
      "kind": "table",
      "sizes": [
        "M"
      ]
    },
    {
      "id": "positions",
      "label": "Open positions",
      "about": "A count for one thread or client",
      "kind": "stat",
      "sizes": [
        "S",
        "M"
      ],
      "params": [
        {
          "key": "thread",
          "label": "Thread",
          "type": "thread"
        },
        {
          "key": "client",
          "label": "Client",
          "type": "client"
        }
      ]
    }
  ]
}
