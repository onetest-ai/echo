{
  "id": "table-demo",
  "name": "Table demo",
  "version": "0.3.0",
  "summary": "A test plugin: a table widget (groups, pills, dates, numbers, details, links), stats with links, a count and a table for a thread or a client with a link, details and an action (tests/cases/today/TC-042, TC-044).",
  "main": "main.js",
  "widgets": [
    {
      "id": "staffing",
      "label": "Needs attention",
      "about": "Positions to staff, by project",
      "kind": "table",
      "sizes": [
        "M",
        "L"
      ],
      "heights": [
        1,
        2
      ]
    },
    {
      "id": "counts",
      "label": "Staffing",
      "about": "Counts that open their rows",
      "kind": "stats",
      "sizes": [
        "M",
        "L"
      ]
    },
    {
      "id": "wrong",
      "label": "Wrong table",
      "about": "A table whose data Echo can't draw",
      "kind": "table",
      "sizes": [
        "M"
      ]
    },
    {
      "id": "positions",
      "label": "Open positions",
      "about": "A count for one thread or client",
      "kind": "stat",
      "sizes": [
        "S",
        "M"
      ],
      "params": [
        {
          "key": "thread",
          "label": "Thread",
          "type": "thread"
        },
        {
          "key": "client",
          "label": "Client",
          "type": "client"
        }
      ]
    },
    {
      "id": "roles",
      "label": "Roles to fill",
      "about": "A thread's or a client's positions: details, a link, an action",
      "kind": "table",
      "sizes": [
        "M",
        "L"
      ],
      "params": [
        {
          "key": "thread",
          "label": "Thread",
          "type": "thread"
        },
        {
          "key": "client",
          "label": "Client",
          "type": "client"
        }
      ]
    }
  ]
}
