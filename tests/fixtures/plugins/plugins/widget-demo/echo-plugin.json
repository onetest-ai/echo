{
  "id": "widget-demo",
  "name": "Widget demo",
  "version": "0.4.0",
  "summary": "A test plugin: Today widgets of each kind Echo draws, its own page, an action, links and a setting (tests/cases/today/TC-029, TC-031–TC-033).",
  "main": "main.js",
  "widgets": [
    {
      "id": "open",
      "label": "Open tickets",
      "about": "a number",
      "kind": "stat",
      "sizes": [
        "S",
        "M"
      ]
    },
    {
      "id": "sprint",
      "label": "Sprint",
      "about": "a few numbers",
      "kind": "stats",
      "sizes": [
        "M",
        "L"
      ]
    },
    {
      "id": "trend",
      "label": "Calls a day",
      "about": "a chart",
      "kind": "chart",
      "sizes": [
        "M",
        "L"
      ]
    },
    {
      "id": "builds",
      "label": "Last builds",
      "about": "a list",
      "kind": "list",
      "sizes": [
        "M",
        "L"
      ],
      "params": [
        {
          "key": "branch",
          "label": "Branch",
          "type": "choice",
          "options": [
            "main",
            "release"
          ],
          "default": "main"
        },
        {
          "key": "thread",
          "label": "Thread",
          "type": "thread"
        }
      ]
    },
    {
      "id": "ci",
      "label": "CI",
      "about": "ok, warn or bad",
      "kind": "status",
      "sizes": [
        "S",
        "M"
      ]
    },
    {
      "id": "note",
      "label": "Note",
      "about": "a card of text",
      "kind": "card",
      "sizes": [
        "M",
        "L"
      ]
    },
    {
      "id": "broken",
      "label": "Broken",
      "about": "data Echo can't draw",
      "kind": "stat",
      "sizes": [
        "S",
        "M"
      ]
    },
    {
      "id": "board",
      "label": "Sprint board",
      "about": "its own page",
      "kind": "page",
      "sizes": [
        "M",
        "L"
      ]
    }
  ],
  "client": "client.js"
}
