{
  "id": "widget-demo",
  "name": "Widget demo",
  "version": "0.1.0",
  "summary": "A test plugin: one Today widget of each kind Echo draws (tests/cases/today/TC-029).",
  "main": "main.js",
  "widgets": [
    { "id": "open", "label": "Open tickets", "about": "a number", "kind": "stat", "sizes": ["S", "M"] },
    { "id": "sprint", "label": "Sprint", "about": "a few numbers", "kind": "stats", "sizes": ["M", "L"] },
    { "id": "builds", "label": "Last builds", "about": "a list", "kind": "list", "sizes": ["M", "L"] },
    { "id": "ci", "label": "CI", "about": "ok, warn or bad", "kind": "status", "sizes": ["S", "M"] },
    { "id": "note", "label": "Note", "about": "a card of text", "kind": "card", "sizes": ["M", "L"] },
    { "id": "broken", "label": "Broken", "about": "data Echo can't draw", "kind": "stat", "sizes": ["S", "M"] }
  ]
}
